/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://pbs.twimg.com data:; connect-src 'self' https://api.x.com; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Cache-Control: no-store
/assets/*
  Cache-Control: public, max-age=31536000, immutable
